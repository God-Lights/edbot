{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edbot-server",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  // 웹 클라이언트(../web)를 같은 주소에서 내보낸다. 파일이 없는 경로(/api, /ws, /auth ...)만 Worker가 처리한다.
  "assets": { "directory": "../web" },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "AUTH", "class_name": "AuthStore" },
      { "name": "MATCH", "class_name": "Matchmaker" },
      { "name": "LIVE", "class_name": "LiveRegistry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["AuthStore"] },
    { "tag": "v3", "new_sqlite_classes": ["Matchmaker"] },
    { "tag": "v4", "new_sqlite_classes": ["LiveRegistry"] }
  ],
  // 전적과 랭킹. database_id를 적지 않으면 배포할 때 wrangler가 DB를 자동으로 만들어 준다.
  // 테이블은 migrations/ 의 SQL로 만든다: npm run db:migrate (로컬은 npm run db:migrate:local)
  "d1_databases": [{ "binding": "DB", "database_name": "edbot", "migrations_dir": "migrations" }],
  // 커스텀 도메인. officialgl.com 존이 이 Cloudflare 계정에 있어야 한다.
  "routes": [{ "pattern": "edgame-api.officialgl.com", "custom_domain": true }],
  "vars": {
    // 단계 시간 배율. 1이면 실제 시간, 0.05면 20배 빠르게 (개발·스모크 테스트용).
    "PHASE_SCALE": "1",
    // 이 서버의 로그인 방식: gl(GL 계정 필수) | hybrid(GL 로그인 또는 이름만) | open(이름만). 운영은 반드시 gl.
    // (server/test/config.test.ts 가 운영 설정이 gl 인지 지킨다. open 은 로컬 서버에서만 쓴다.)
    "AUTH_MODE": "gl",
    "SERVER_ENV": "production",
    "SERVER_NAME": "COMMANDER",
    "EDITION": "vanilla"
    // GL_ACCOUNT_KEY는 시크릿이라 여기에 쓰지 않는다: npx wrangler secret put GL_ACCOUNT_KEY
    // 로컬 개발에서 로그인 검사를 끄려면 .dev.vars 에 AUTH_MODE=open (예전 방식 REQUIRE_AUTH=false 도 된다)
  },
  // 개발 서버: 운영과 완전히 따로(이름이 달라서 방·로그인 저장소도 따로, D1도 edbot-dev). 배포: npm run deploy:dev
  // 환경은 바인딩과 vars 를 물려받지 않아서 필요한 것을 다시 적는다. 도메인은 아직 없다(workers.dev 주소를 쓴다).
  "env": {
    "dev": {
      "name": "edbot-server-dev",
      "routes": [],
      "vars": {
        "PHASE_SCALE": "1",
        "AUTH_MODE": "hybrid",
        "SERVER_ENV": "development",
        "SERVER_NAME": "COMMANDER 개발 서버",
        "EDITION": "expert"
      },
      "durable_objects": {
        "bindings": [
          { "name": "ROOM", "class_name": "Room" },
          { "name": "AUTH", "class_name": "AuthStore" },
          { "name": "MATCH", "class_name": "Matchmaker" },
          { "name": "LIVE", "class_name": "LiveRegistry" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["Room"] },
        { "tag": "v2", "new_sqlite_classes": ["AuthStore"] },
        { "tag": "v3", "new_sqlite_classes": ["Matchmaker"] },
        { "tag": "v4", "new_sqlite_classes": ["LiveRegistry"] }
      ],
      "d1_databases": [{ "binding": "DB", "database_name": "edbot-dev", "migrations_dir": "migrations" }]
    }
  }
}
