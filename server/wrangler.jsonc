{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edbot-server",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    // 단계 시간 배율. 1이면 실제 시간, 0.05면 20배 빠르게 (개발·스모크 테스트용).
    "PHASE_SCALE": "1"
  }
}
